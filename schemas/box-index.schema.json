{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:box-storage-memory:schema:box-index:1",
  "title": "Box Storage box-index v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "updated",
    "boxes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updated": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "boxId",
          "boxNumber",
          "name",
          "driveFolderId",
          "nfcIds"
        ],
        "properties": {
          "boxId": {
            "$ref": "#/$defs/uuid"
          },
          "boxNumber": {
            "$ref": "#/$defs/boxNumber"
          },
          "name": {
            "$ref": "#/$defs/meaningfulText"
          },
          "driveFolderId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$(?![\\s\\S])"
          },
          "location": {
            "type": "string"
          },
          "nfcIds": {
            "$ref": "#/$defs/nfcIds"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "boxNumber": {
      "type": "string",
      "pattern": "^BOX-(?=[0-9]*[1-9])(?:[0-9]{4}|[1-9][0-9]{4,8})$(?![\\s\\S])"
    },
    "meaningfulText": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,3})?Z$(?![\\s\\S])"
    },
    "nfcId": {
      "type": "string",
      "pattern": "^(?:[0-9A-F]{2}){1,32}$(?![\\s\\S])"
    },
    "imageFilename": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^./\\\\:\\x00-\\x1F\\x7F%?#][^/\\\\:\\x00-\\x1F\\x7F%?#]*\\.(?:jpg|jpeg|png|webp)$(?![\\s\\S])"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "nfcIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[0-9A-F]{2}){1,32}$(?![\\s\\S])"
      },
      "uniqueItems": true
    }
  }
}
