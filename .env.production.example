APP_NAME=Box Storage
# Origin only: no subpath. The hostname must resolve to this host, with ports 80/443 reachable.
BOX_STORAGE_HOST=boxes.example.com
PUBLIC_URL=https://boxes.example.com
GOOGLE_WEB_CLIENT_ID=
BOX_STORAGE_IMAGE=box-storage-memory:1.0.0
LOG_LEVEL=INFO
ENABLE_WEB_NFC=false
MAX_REQUEST_BYTES=1048576
UTILITY_REQUESTS_PER_MINUTE=60
UTILITY_GLOBAL_REQUESTS_PER_MINUTE=600
