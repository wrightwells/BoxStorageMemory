from pathlib import Path
from typing import Any, Literal, TypedDict

class Issue(TypedDict):
    path: str
    code: str

class ValidationResult(TypedDict):
    valid: bool
    errors: list[Issue]

def public_origin(value: str) -> str: ...
def qr_url(public_url: str, box_id: str) -> str: ...

class ContractValidator:
    def __init__(self, schema_dir: Path | None = ...) -> None: ...
    def validate_library(self, index: object, inventories: dict[str, Any]) -> ValidationResult: ...
    def validate(self, kind: Literal["inventory", "index"], document: Any) -> ValidationResult: ...

def valid_datetime(value: object) -> bool: ...
def normalize_nfc(value: object) -> str: ...
def normalize_box_number(value: object) -> str: ...
def parse_qr(value: str, public_url: str) -> str: ...
def schema_mode(document: object) -> Literal["supported", "read-only", "invalid"]: ...
def issue(path: str, code: str) -> Issue: ...
def pointer(parts: list[str | int]) -> str: ...
def domain_errors(kind: Literal["inventory", "index"], document: dict[str, Any]) -> list[Issue]: ...
def edit_item(
    document: dict[str, Any], item_id: str, changes: dict[str, Any]
) -> dict[str, Any]: ...
