APP_NAME=Box Storage
PUBLIC_URL=http://localhost:8080
# Operator-managed public web registration, shared by all users of this deployment.
# Register the exact trusted browser origin with Google; users need no Cloud/payment setup.
# Leave empty to use the stateless API without enabling web Google authorization.
GOOGLE_WEB_CLIENT_ID=
API_PORT=8080
HOST_PORT=8080
BOX_STORAGE_IMAGE=box-storage-memory:local
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
ENABLE_WEB_NFC=false
ENABLE_API_DOCS=false
MAX_REQUEST_BYTES=1048576
UTILITY_REQUESTS_PER_MINUTE=60
UTILITY_GLOBAL_REQUESTS_PER_MINUTE=600
# Optional compose.host-ip.yaml: bind only the requested host interface.
HOST_IP_ADDRESS=
