{
  "components": {
    "schemas": {
      "Compatibility": {
        "properties": {
          "minimumAndroidClientVersion": {
            "title": "Minimumandroidclientversion",
            "type": "string"
          },
          "minimumWebClientVersion": {
            "title": "Minimumwebclientversion",
            "type": "string"
          },
          "supportedSchemaVersions": {
            "items": {
              "type": "integer"
            },
            "title": "Supportedschemaversions",
            "type": "array"
          }
        },
        "required": [
          "supportedSchemaVersions",
          "minimumWebClientVersion",
          "minimumAndroidClientVersion"
        ],
        "title": "Compatibility",
        "type": "object"
      },
      "DriveFolderQRRequest": {
        "additionalProperties": false,
        "properties": {
          "folderId": {
            "pattern": "^[A-Za-z0-9_-]{1,256}$(?![\\s\\S])",
            "title": "Folderid",
            "type": "string"
          }
        },
        "required": [
          "folderId"
        ],
        "title": "DriveFolderQRRequest",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Features": {
        "properties": {
          "qrFormat": {
            "const": "png",
            "default": "png",
            "title": "Qrformat",
            "type": "string"
          },
          "webNfc": {
            "title": "Webnfc",
            "type": "boolean"
          }
        },
        "required": [
          "webNfc"
        ],
        "title": "Features",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "apiVersion": {
            "const": "v1",
            "default": "v1",
            "title": "Apiversion",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JsonValue": {},
      "PublicConfig": {
        "properties": {
          "apiVersion": {
            "const": "v1",
            "default": "v1",
            "title": "Apiversion",
            "type": "string"
          },
          "appName": {
            "title": "Appname",
            "type": "string"
          },
          "applicationVersion": {
            "title": "Applicationversion",
            "type": "string"
          },
          "compatibility": {
            "$ref": "#/components/schemas/Compatibility"
          },
          "features": {
            "$ref": "#/components/schemas/Features"
